local plr = game:GetService("Players").LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local humanoid = char:WaitForChild("Humanoid")
local cam = workspace.CurrentCamera
local run = game:GetService("RunService")

local tool = Instance.new("Tool")
local vel
local event

tool.Name = "Swim"
tool.RequiresHandle = false
tool.Parent = plr.Backpack

local speed = 17.5
local fixedHeight = root.Position.Y -- saves your current height

tool.Equipped:Connect(function()
    fixedHeight = root.Position.Y -- update height when equipped

    vel = Instance.new("BodyVelocity")
    vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    vel.P = 1000000
    vel.Parent = root

    humanoid:SetStateEnabled("GettingUp", false)
    humanoid:ChangeState("Swimming")

    event = run.Heartbeat:Connect(function()
        local cf = cam.CFrame
        local move = humanoid.MoveDirection * speed

        local direction = Vector3.new(
            move.X,
            0,
            move.Z
        )

        -- Keep player locked at fixed height
        local heightForce = (fixedHeight - root.Position.Y) * 50

        vel.Velocity = Vector3.new(
            direction.X,
            heightForce,
            direction.Z
        )

        humanoid:ChangeState("Swimming")
    end)
end)

tool.Unequipped:Connect(function()
    if event then
        event:Disconnect()
    end

    if vel then
        vel:Destroy()
    end

    humanoid:SetStateEnabled("GettingUp", true)
end)
